-- Удаляем старые объекты
DROP FUNCTION IF EXISTS fn_calc_meteo_corrections(parameter_list, int) CASCADE;
DROP FUNCTION IF EXISTS fn_calc_interpolation_from_array(numeric, int[], int[]) CASCADE;
DROP FUNCTION IF EXISTS fn_format_bulletin_header(int, int, numeric, numeric) CASCADE;
DROP PROCEDURE IF EXISTS pr_calc_meteo_corrections(parameter_list, int) CASCADE;

-- Вспомогательная функция: Линейная интерполяция по массиву заголовков и значений
CREATE OR REPLACE FUNCTION fn_calc_interpolation_from_array(
    p_x numeric,
    p_headers int[],
    p_values int[]
)
RETURNS numeric AS
$$
DECLARE
    v_x0 numeric;
    v_y0 numeric;
    v_x1 numeric;
    v_y1 numeric;
    v_result numeric;
    v_i int;
    v_len int;
BEGIN
    v_len := array_length(p_headers, 1);
    
    IF v_len IS NULL OR v_len = 0 OR p_values IS NULL THEN
        RETURN NULL;
    END IF;
    
    -- Точное совпадение
    FOR v_i IN 1..v_len
    LOOP
        IF p_headers[v_i] = p_x THEN
            RETURN p_values[v_i]::numeric;
        END IF;
    END LOOP;
    
    -- Линейная интерполяция
    FOR v_i IN 1..v_len - 1
    LOOP
        IF p_headers[v_i] <= p_x AND p_headers[v_i + 1] >= p_x THEN
            v_x0 := p_headers[v_i];
            v_y0 := p_values[v_i];
            v_x1 := p_headers[v_i + 1];
            v_y1 := p_values[v_i + 1];
            
            IF v_x1 = v_x0 THEN
                v_result := v_y0;
            ELSE
                v_result := v_y0 + (v_y1 - v_y0) * (p_x - v_x0) / (v_x1 - v_x0);
            END IF;
            
            RETURN v_result;
        END IF;
    END LOOP;
    
    RETURN NULL;
END;
$$
LANGUAGE plpgsql;

COMMENT ON FUNCTION fn_calc_interpolation_from_array(numeric, int[], int[]) 
IS 'Линейная интерполяция по массиву заголовков и значений';

-- Функция форматирования заголовка бюллетеня
CREATE OR REPLACE FUNCTION fn_format_bulletin_header(
    p_height int,
    p_pressure int,
    p_temp numeric,
    p_delta_tv numeric
)
RETURNS text AS $$
DECLARE
    v_ddchm text;
    v_vvvv text;
    v_bbb text;
    v_tt text;
    v_delta_h0 int;
    v_t0 numeric;
    v_delta_t0 int;
BEGIN
    v_t0 := p_temp + p_delta_tv;
    v_delta_h0 := p_pressure - 750;
    v_delta_t0 := round(v_t0 - 15.9)::int;
    
    v_ddchm := lpad(extract(day from now())::text, 2, '0') ||
               lpad(extract(hour from now())::text, 2, '0') ||
               lpad(floor(extract(minute from now()) / 10)::text, 1, '0');
    
    v_vvvv := lpad(p_height::text, 4, '0');
    
    IF v_delta_h0 >= 0 THEN
        v_bbb := lpad(v_delta_h0::text, 3, '0');
    ELSE
        v_bbb := '5' || lpad(abs(v_delta_h0)::text, 2, '0');
    END IF;
    
    IF v_delta_t0 >= 0 THEN
        v_tt := lpad(v_delta_t0::text, 2, '0');
    ELSE
        v_tt := '5' || lpad(abs(v_delta_t0)::text, 1, '0');
    END IF;
    
    RETURN v_ddchm || v_vvvv || v_bbb || v_tt;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION fn_format_bulletin_header(int, int, numeric, numeric) 
IS 'Форматирование заголовка метеобюллетеня (ДДЧЧМВВВВБББТТ)';


-- Основная процедура расчета поправок
CREATE OR REPLACE FUNCTION fn_calc_meteo_corrections(
    params parameter_list,
    p_device_id int
)
RETURNS TABLE (
    height integer,
    temp_correction numeric,
    wind_speed_correction numeric,
    wind_dir_correction numeric
) AS
$$
DECLARE
    v_height_id int;
    v_height_val int;
    v_type_t2_pos int;
    v_type_t2_neg int;
    v_type_t3_wind int;
    v_type_t3_dir int;
    v_row_values int[];
    v_headers int[];
    v_wind_value numeric;
	v_current_type_id int;
	v_delta_t0 int;
    v_t0 numeric;
    v_delta_tv numeric;
    v_tens int;
    v_units int;
    v_tens_value numeric;
    v_units_value numeric;
BEGIN
	
    -- Определяем типы таблиц по описанию
    SELECT id INTO v_type_t2_pos 
    FROM calc_correction_types 
	WHERE parent_id = 1 AND is_positive = true;
	
    SELECT id INTO v_type_t2_neg 
    FROM calc_correction_types 
	WHERE parent_id = 1 AND is_positive = false;
	
	-- Ветровые поправки
	SELECT id INTO v_type_t3_wind 
	FROM calc_correction_types 
	WHERE parent_id = 4 AND measurment_equipment_id = p_device_id;
    
	SELECT id INTO v_type_t3_dir 
	FROM calc_correction_types 
	WHERE parent_id = 7 AND measurment_equipment_id = p_device_id;
	  
    -- Определяем значение ветра в зависимости от оборудования
    IF p_device_id = 1 THEN
        v_wind_value := params.wind_speed;  -- ДМК: скорость ветра
    ELSIF p_device_id = 2 THEN
        v_wind_value := params.drift;       -- ВР: дальность сноса
    ELSE
        RAISE EXCEPTION 'Неизвестный тип оборудования: %. Допустимые значения: 1 (ДМК), 2 (ВР)', p_device_id;
    END IF;
    
    -- Проходим по всем стандартным высотам
    FOR v_height_id, v_height_val IN 
        SELECT h.id, h.height 
        FROM calc_correction_heights h 
        ORDER BY h.height
    LOOP
		--виртуальная поправка из таблицы 1
		SELECT fn_calc_temperature_interpolation(params.temperature) INTO v_delta_tv;
	    --виртуальная температура и отклонение
		v_t0 := params.temperature + v_delta_tv;
        v_delta_t0 := round(v_t0 - 15.9)::int;
        -- Определяем, какую таблицу использовать 
        IF v_delta_t0 >= 0 THEN
            SELECT row_values INTO v_row_values
            FROM calc_correction
            WHERE height_id = v_height_id AND type_id = v_type_t2_pos;
			v_current_type_id := v_type_t2_pos;
        ELSE
            SELECT row_values INTO v_row_values
            FROM calc_correction
            WHERE height_id = v_height_id AND type_id = v_type_t2_neg;
        	v_current_type_id := v_type_t2_neg;
		END IF;
        
        -- Получаем заголовки из родительской записи 
        SELECT array_agg(header_value ORDER BY sort_order) INTO v_headers
        FROM calc_correction_headers
        WHERE type_id = v_current_type_id;
        
        IF v_row_values IS NOT NULL AND v_headers IS NOT NULL THEN
            -- Разкладываем отклонение на десятки и единицы
            v_tens := (v_delta_t0 / 10) * 10;
            v_units := v_delta_t0 - v_tens;
            
            -- Находим значения для десятков и единиц
            SELECT fn_calc_interpolation_from_array(v_tens::numeric, v_headers, v_row_values) 
            INTO v_tens_value;
            
            SELECT fn_calc_interpolation_from_array(v_units::numeric, v_headers, v_row_values) 
            INTO v_units_value;
            
            -- Складываем
            IF v_tens_value IS NOT NULL AND v_units_value IS NOT NULL THEN
                temp_correction := v_tens_value + v_units_value;
			ELSE
            	temp_correction := NULL;
        	END IF;
		ELSE
            temp_correction := NULL;
        END IF;
        
        -- Скорость ветра
        SELECT row_values INTO v_row_values
        FROM calc_correction
        WHERE height_id = v_height_id AND type_id = v_type_t3_wind;
        
        SELECT array_agg(header_value ORDER BY sort_order) INTO v_headers
        FROM calc_correction_headers
        WHERE type_id = v_type_t3_wind;
        
        IF v_row_values IS NOT NULL AND v_headers IS NOT NULL THEN
            wind_speed_correction := fn_calc_interpolation_from_array(v_wind_value, v_headers, v_row_values);
        ELSE
            wind_speed_correction := NULL;
        END IF;
        
        --Направление ветра
        SELECT row_values INTO v_row_values
        FROM calc_correction
        WHERE height_id = v_height_id AND type_id = v_type_t3_dir;
        
        SELECT array_agg(header_value ORDER BY sort_order) INTO v_headers
        FROM calc_correction_headers
        WHERE type_id = v_type_t3_dir;
        
        IF v_row_values IS NOT NULL AND v_headers IS NOT NULL THEN
            wind_dir_correction := fn_calc_interpolation_from_array(v_wind_value, v_headers, v_row_values);
        ELSE
            wind_dir_correction := NULL;
        END IF;
        
        height := v_height_val;
        RETURN NEXT;
    END LOOP;
    
    RETURN;
END;
$$
LANGUAGE plpgsql;

COMMENT ON FUNCTION fn_calc_meteo_corrections(parameter_list, int) 
IS 'Расчет метеорологических поправок по каждой стандартной высоте';

-- Процедура расчета поправок
CREATE OR REPLACE PROCEDURE pr_calc_meteo_corrections(
    params parameter_list,
    p_device_id int
) AS $$
DECLARE
    v_height int;
    v_temp numeric;
    v_wind_speed numeric;
    v_wind_dir numeric;
BEGIN
    FOR v_height, v_temp, v_wind_speed, v_wind_dir IN
        SELECT height, temp_correction, wind_speed_correction, wind_dir_correction
        FROM fn_calc_meteo_corrections(params, p_device_id)
    LOOP
        RAISE NOTICE '% м | % | % | %',
            v_height, v_temp, v_wind_speed, v_wind_dir;
    END LOOP;
END;
$$ LANGUAGE plpgsql;

COMMENT ON PROCEDURE pr_calc_meteo_corrections(parameter_list, int) 
IS 'Процедура расчета метеорологических поправок с выводом результатов';