COMMIT;

-- Транзакция 3: Создание связей и ограничений
BEGIN;

-- Связь: пользователь - должность (нельзя удалить должность, пока есть пользователи)
ALTER TABLE t1_users 
ADD CONSTRAINT fk_t1_users_position
FOREIGN KEY (position_id) REFERENCES t1_positions(id) ON DELETE RESTRICT;

-- Связь: пачка - пользователь (при удалении пользователя удалятся его пачки)
ALTER TABLE t1_batches 
ADD CONSTRAINT fk_t1_batches_user
FOREIGN KEY (user_id) REFERENCES t1_users(id) ON DELETE CASCADE;

-- Связь: измерение - пачка (каскадное удаление)
ALTER TABLE t1_measurements 
ADD CONSTRAINT fk_t1_measurements_batch
FOREIGN KEY (batch_id) REFERENCES t1_batches(id) ON DELETE CASCADE;

-- Ограничение: номер пачки должен быть положительным
ALTER TABLE t1_batches 
ADD CONSTRAINT chk_t1_batch_number_positive
CHECK (batch_number > 0);

-- Ограничение: значение измерения не может быть NULL
ALTER TABLE t1_measurements 
ADD CONSTRAINT chk_t1_value_not_null
CHECK (value IS NOT NULL);

COMMIT;

--Запрос к метаданным (information_schema)

SELECT 
    ROW_NUMBER() OVER (ORDER BY table_name) AS "№",
    table_name AS "Наименование",
    'Таблица' AS "Тип"
FROM information_schema.tables 
WHERE table_schema = 'public' 
  AND table_name LIKE 't1_%'  -- показываем только наши новые таблицы
  AND table_type = 'BASE TABLE'
ORDER BY "№";

-- Дополнительно: информация о колонках наших таблиц
SELECT 
    table_name AS "Таблица",
    column_name AS "Колонка",
    data_type AS "Тип данных",
    is_nullable AS "NULL?",
    COALESCE(character_maximum_length::VARCHAR, '') AS "Длина"
FROM information_schema.columns
WHERE table_schema = 'public'
  AND table_name LIKE 't1_%'
ORDER BY table_name, ordinal_position;

-- Информация о последовательностях
SELECT 
    sequence_name AS "Наименование",
    data_type AS "Тип",
    start_value AS "Старт",
    minimum_value AS "Мин",
    maximum_value AS "Макс"
FROM information_schema.sequences
WHERE sequence_schema = 'public'
  AND sequence_name LIKE 'seq_t1_%'
ORDER BY sequence_name;

-- Проверочный запрос

SELECT 
    b.batch_number AS "Пачка",
    u.full_name AS "Сотрудник",
    p.name AS "Должность",
    m.parameter_name AS "Параметр",
    m.value AS "Значение",
    m.unit AS "Ед. изм."
FROM t1_batches b
JOIN t1_users u ON u.id = b.user_id
JOIN t1_positions p ON p.id = u.position_id
JOIN t1_measurements m ON m.batch_id = b.id
ORDER BY b.batch_number, m.id;