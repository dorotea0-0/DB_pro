DO
$$
BEGIN
    -- Сначала чистим всё, что могло остаться от предыдущих запусков
    DROP TABLE IF EXISTS parameters CASCADE;
    DROP TABLE IF EXISTS batch CASCADE;
    DROP TABLE IF EXISTS soldiers CASCADE;
    DROP TABLE IF EXISTS ranks CASCADE;
    DROP TABLE IF EXISTS devices CASCADE;
    DROP TABLE IF EXISTS unit_meas CASCADE;
    DROP TABLE IF EXISTS base_unit_meas CASCADE;
    DROP TABLE IF EXISTS type_parameter CASCADE;
    DROP TABLE IF EXISTS temp_correction;
    
    -- Удаляем все последовательности
    DROP SEQUENCE IF EXISTS seq_soldiers CASCADE;
    DROP SEQUENCE IF EXISTS seq_base_unit_meas CASCADE;
    DROP SEQUENCE IF EXISTS seq_batch CASCADE;
    DROP SEQUENCE IF EXISTS seq_devices CASCADE;
    DROP SEQUENCE IF EXISTS seq_parameters CASCADE;
    DROP SEQUENCE IF EXISTS seq_ranks CASCADE;
    DROP SEQUENCE IF EXISTS seq_type_parameter CASCADE;
    DROP SEQUENCE IF EXISTS seq_unit_meas CASCADE;
    DROP SEQUENCE IF EXISTS seq_temp_correction;

    -- Создаём последовательности для автогенерации ID
    CREATE SEQUENCE seq_soldiers;
    CREATE SEQUENCE seq_base_unit_meas;
    CREATE SEQUENCE seq_batch;
    CREATE SEQUENCE seq_devices;
    CREATE SEQUENCE seq_parameters;
    CREATE SEQUENCE seq_ranks;
    CREATE SEQUENCE seq_type_parameter;
    CREATE SEQUENCE seq_unit_meas;
    CREATE SEQUENCE seq_temp_correction;
	-- Справочник военных званий
    -- Хранит все возможные звания от рядового до полковника
    CREATE TABLE ranks(
        id INT PRIMARY KEY DEFAULT nextval('seq_ranks'),
        rank TEXT
    );
    COMMENT ON TABLE ranks IS 'Справочник военных званий';
    COMMENT ON COLUMN ranks.rank IS 'Название звания';

    -- Справочник типов измерительного оборудования
    CREATE TABLE devices(
        id INT PRIMARY KEY DEFAULT nextval('seq_devices'),
        name TEXT
    );
    COMMENT ON TABLE devices IS 'Справочник типов оборудования для измерений';
    COMMENT ON COLUMN devices.name IS 'Название оборудования';

    -- Таблица военнослужащих
    CREATE TABLE soldiers(
        id INT PRIMARY KEY DEFAULT nextval('seq_soldiers'),
        personal_id INT,
        rank_id INT
    );
    COMMENT ON TABLE soldiers IS 'Справочник военнослужащих';
    COMMENT ON COLUMN soldiers.personal_id IS 'Личный номер военнослужащего';
    COMMENT ON COLUMN soldiers.rank_id IS 'Звание военнослужащего из ranks';

    -- Базовые единицы измерения
    CREATE TABLE base_unit_meas (
        id INT PRIMARY KEY DEFAULT nextval('seq_base_unit_meas'),
        name TEXT
    );
    COMMENT ON TABLE base_unit_meas IS 'Справочник базовых единиц измерения';
    COMMENT ON COLUMN base_unit_meas.id IS 'Уникальный код ед. измерения';
    COMMENT ON COLUMN base_unit_meas.name IS 'Единица измерения';

    -- Все единицы измерения (включая производные)
    CREATE TABLE unit_meas (
        id INT PRIMARY KEY DEFAULT nextval('seq_unit_meas'),
        base_id INT,
        name TEXT,
        factor NUMERIC
    );
    COMMENT ON TABLE unit_meas IS 'Справочник всех единиц измерения';
    COMMENT ON COLUMN unit_meas.id IS 'Уникальный код ед. измерения';
    COMMENT ON COLUMN unit_meas.name IS 'Единица измерения';
    COMMENT ON COLUMN unit_meas.base_id IS 'Уникальный код базовой единицы';
    COMMENT ON COLUMN unit_meas.factor IS 'Коэффициент от базовой единицы';

    -- Справочник типов параметров, которые мы измеряем
    -- Высота, температура, давление, ветер
    CREATE TABLE type_parameter (
        id INT PRIMARY KEY DEFAULT nextval('seq_type_parameter'),
        name TEXT
    );
    COMMENT ON TABLE type_parameter IS 'Справочник типов параметров для измерения';
    COMMENT ON COLUMN type_parameter.id IS 'Уникальный код типа параметра';
    COMMENT ON COLUMN type_parameter.name IS 'Тип параметра';

    -- Таблица параметров измерений
    -- Здесь хранятся фактические значения
    -- Это центральная таблица, которая связывает всё вместе
    CREATE TABLE parameters (
        id INT PRIMARY KEY DEFAULT nextval('seq_parameters'),
        batch_id INT,
        type_par_id INT,
        unit_meas_id INT,
        value NUMERIC
    );
    COMMENT ON TABLE parameters IS 'Параметры метеорологических измерений для расчёта';
    COMMENT ON COLUMN parameters.id IS 'Уникальный код параметра';
    COMMENT ON COLUMN parameters.batch_id IS 'Уникальный код пачки';
    COMMENT ON COLUMN parameters.type_par_id IS 'Уникальный код типа параметра';
    COMMENT ON COLUMN parameters.unit_meas_id IS 'Уникальный код ед. измерения';
    COMMENT ON COLUMN parameters.value IS 'Значение параметра';

    -- Таблица пачек измерений
    CREATE TABLE batch(
        id INT PRIMARY KEY DEFAULT nextval('seq_batch'),
        soldier_id INT,
        device_id INT,
        measured_at TIMESTAMPTZ DEFAULT now()
    );
    COMMENT ON TABLE batch IS 'История измерений (кто, параметры и дата)';
    COMMENT ON COLUMN batch.soldier_id IS 'Военнослужащий из soldiers';
    COMMENT ON COLUMN batch.device_id IS 'Уникальный код устройства';
    COMMENT ON COLUMN batch.measured_at IS 'Дата и время измерения';

    -- Таблица температурных поправок (виртуальная таблица из задания)
    CREATE TABLE temp_correction (
        id INT PRIMARY KEY DEFAULT nextval('seq_temp_correction'),
        t0 NUMERIC NOT NULL,
        delta_tv NUMERIC
    );
    COMMENT ON TABLE temp_correction IS 'Корректировка температуры';
    COMMENT ON COLUMN temp_correction.id IS 'Уникальный код поправки';
    COMMENT ON COLUMN temp_correction.t0 IS 'Измеренная температура';
    COMMENT ON COLUMN temp_correction.delta_tv IS 'Виртуальная поправка';

    -- Фиксируем первую транзакцию - структура создана
end
$$;
do
$$
