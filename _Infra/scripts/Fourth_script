    -- Пачки с ВР (солдаты 2, 4, 6) - batch_id 5-8, 13-16, 21-24
    -- Вместо скорости ветра измеряем дальность сноса пуль
    
    -- batch 5 (солдат 2, первая пачка)
    INSERT INTO parameters(batch_id, type_par_id, unit_meas_id, value) VALUES
