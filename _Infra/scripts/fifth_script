do
$do$
begin
    -- Удаляем старые объекты, если они есть
    drop function if exists interpolate(numeric, interpolation_points) cascade;
    drop function if exists get_interpolation_points(numeric) cascade;
    drop type if exists interpolation_points cascade;

    -- Тип данных для интерполяции
    -- Хранит две точки и для линейной интерполяции
    create type interpolation_points as (
        x0 numeric,
        y0 numeric,
        x1 numeric,
        y1 numeric
    );
    comment on type interpolation_points is 'Структура для линейной интерполяции ';

    -- Функция: получение точек интерполяции по температуре
    -- Находит две ближайшие точки из таблицы temp_correction
    create or replace function get_interpolation_points(temp numeric)
    returns interpolation_points as
    $func$
    declare
        result interpolation_points;
    begin
        -- Берём ближайшую точку слева и справа 
        select
            t0_left, delta_left, t0_right, delta_right
        into result
        from (
            select
                (select t0 from temp_correction where t0 <= temp order by t0 desc limit 1) as t0_left,
                (select delta_tv from temp_correction where t0 <= temp order by t0 desc limit 1) as delta_left,
                (select t0 from temp_correction where t0 >= temp order by t0 asc limit 1) as t0_right,
                (select delta_tv from temp_correction where t0 >= temp order by t0 asc limit 1) as delta_right
        ) sub;

        -- Если температура вне диапазона - берём крайние точки
        if result.x0 is null then
            select t0, delta_tv into result.x0, result.y0
            from temp_correction order by t0 asc limit 1;
            select t0, delta_tv into result.x1, result.y1
            from temp_correction order by t0 asc limit 1 offset 1;
        end if;

        if result.x1 is null then
            select t0, delta_tv into result.x0, result.y0
            from temp_correction order by t0 desc limit 1 offset 1;
            select t0, delta_tv into result.x1, result.y1
            from temp_correction order by t0 desc limit 1;
        end if;

        -- Если температура точно совпадает с точкой - обе точки одинаковые
        if result.x0 = result.x1 then
            result.y0 := result.y1;
        end if;

        return result;
    end;
    $func$
	create or replace function interpolate(x numeric, points interpolation_points)
	returns numeric as
	$func2$
	begin
    	-- Проверка деления на ноль: если обе точки имеют одинаковый x,
    	-- интерполяция невозможна - возвращаем y0
    	if points.x1 = points.x0 then
        	return points.y0;
    	end if;

    	return points.y0 + (points.y1 - points.y0) * (x - points.x0) / (points.x1 - points.x0);
	end;
	$func2$
	language plpgsql;
    comment on function interpolate(numeric, interpolation_points) is 'Линейная интерполяция по двум точкам';

end
$do$;