-- SELECT с объединением всех таблиц
SELECT
    b.id AS batch_id,
    b.batch_number AS batch_number,
    b.time_at AS time_at,
    et.id AS equipment_type_id,
    et.name AS equipment_name,
    u.id AS user_id,
    u.login AS user_login,
    u.full_name AS user_full_name,
    pos.id AS position_id,
    pos.name AS position_name,
    prm.id AS parameter_id,
    prm.name AS parameter_name,
    b.param_value AS param_value
FROM batches AS b
    JOIN users AS u ON u.id = b.user_id
    JOIN positions AS pos ON pos.id = u.position_id
    JOIN equipment_types AS et ON et.id = b.equipment_type_id
    JOIN parameters AS prm ON prm.id = b.parameter_id