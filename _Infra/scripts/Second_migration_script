--Миграция

CREATE TABLE parameter_types (
    id INTEGER NOT NULL PRIMARY KEY,
    name VARCHAR(50) NOT NULL UNIQUE,
    min_value DECIMAL,
    max_value DECIMAL,
    default_value DECIMAL NOT NULL
);

CREATE TABLE base_units (
    id INTEGER NOT NULL PRIMARY KEY,
    name VARCHAR(20) NOT NULL,
    parameter_type_id INTEGER NOT NULL REFERENCES parameter_types (id)
);

CREATE TABLE units (
    id INTEGER NOT NULL PRIMARY KEY,
    name VARCHAR(20) NOT NULL,
    conversion DECIMAL NOT NULL,
    base_unit_id INTEGER NOT NULL REFERENCES base_units (id)
);

-- Переносим старый справочник параметров в parameter_types
INSERT INTO parameter_types (id, name, min_value, max_value, default_value)
SELECT id, name, min_value, max_value, default_value FROM parameters;

-- Базовые единицы для каждого типа параметра
INSERT INTO base_units (id, name, parameter_type_id) VALUES 
(1, 'м', 1), (2, 'грC', 2), (3, 'гПа', 3), 
(4, 'гр', 4), (5, 'м/с', 5), (6, 'м', 6);

-- Конкретные единицы с коэффициентами пересчёта к базовой
INSERT INTO units (id, name, conversion, base_unit_id) VALUES 
-- Длина
(1, 'м', 1, 1), (2, 'см', 0.01, 1), (3, 'мм', 0.001, 1), (4, 'км', 1000, 1),
-- Температура 
(5, 'грC', 1, 2), (6, 'грF', 0.5556, 2),
-- Давление
(7, 'гПа', 1, 3), (8, 'мм рт.ст.', 1.333, 3), (9, 'Па', 0.01, 3),
-- Углы 
(10, 'гр', 1, 4), (11, 'рад', 57.2958, 4),
-- Скорость
(12, 'м/с', 1, 5), (13, 'км/ч', 0.2778, 5),
-- Дальность сноса
(14, 'м', 1, 6), (15, 'см', 0.01, 6);

-- Разрываем старую связь batches и parameters
ALTER TABLE batches DROP CONSTRAINT batches_parameter_id_fkey;

-- Создаём новую таблицу parameters, она теперь хранит фактические замеры
CREATE TABLE parameters_new (
    id INTEGER NOT NULL PRIMARY KEY,
    parameter_type_id INTEGER NOT NULL REFERENCES parameter_types (id),
    value DECIMAL NOT NULL,
    batch_id INTEGER NOT NULL
);

-- Мигрируем данные, используя MIN для каждого batch_number как batch_id
-- Это гарантирует, что batch_id будет существовать после удаления дубликатов
INSERT INTO parameters_new (id, parameter_type_id, value, batch_id)
SELECT 
    b.id, 
    b.parameter_id, 
    b.param_value, 
    (SELECT MIN(id) FROM batches b2 WHERE b2.batch_number = b.batch_number)
FROM batches AS b;

-- Теперь удаляем дубликаты из batches
DELETE FROM batches WHERE id NOT IN (SELECT MIN(id) FROM batches GROUP BY batch_number);

-- Переименовываем новую таблицу
DROP TABLE parameters;
ALTER TABLE parameters_new RENAME TO parameters;

-- Убираем из batches поля, которые переехали в parameters
ALTER TABLE batches DROP COLUMN parameter_id;
ALTER TABLE batches DROP COLUMN param_value;
ALTER TABLE batches DROP COLUMN batch_number;

-- Таблица "Расчет температуры"

CREATE TABLE temperature_calculations (
    id SERIAL PRIMARY KEY,
    batch_id INTEGER NOT NULL REFERENCES batches(id) ON DELETE CASCADE,
    original_celsius DECIMAL NOT NULL,
    calculated_kelvin DECIMAL NOT NULL,
    calculation_rule VARCHAR(100),
    calculated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Пересчёт температуры
INSERT INTO temperature_calculations (batch_id, original_celsius, calculated_kelvin, calculation_rule)
SELECT 
    p.batch_id,
    p.value,
    ROUND((p.value + 273.15)::numeric, 2),
    'K = C + 273.15'
FROM parameters p
JOIN parameter_types pt ON pt.id = p.parameter_type_id
WHERE pt.name = 'Температура';

-- Транзакция 1: структура и счётчики
BEGIN;

CREATE SEQUENCE seq_t1_positions START 1;
CREATE SEQUENCE seq_t1_users START 1;
CREATE SEQUENCE seq_t1_batches START 1;
CREATE SEQUENCE seq_t1_measurements START 1;

CREATE TABLE t1_positions (
    id INTEGER NOT NULL DEFAULT nextval('seq_t1_positions') PRIMARY KEY,
    name VARCHAR(50) NOT NULL UNIQUE
);

CREATE TABLE t1_users (
    id INTEGER NOT NULL DEFAULT nextval('seq_t1_users') PRIMARY KEY,
    login VARCHAR(20) NOT NULL UNIQUE,
    full_name VARCHAR(100) NOT NULL,
    position_id INTEGER NOT NULL
);

CREATE TABLE t1_batches (
    id INTEGER NOT NULL DEFAULT nextval('seq_t1_batches') PRIMARY KEY,
    batch_number INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    measured_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE t1_measurements (
    id INTEGER NOT NULL DEFAULT nextval('seq_t1_measurements') PRIMARY KEY,
    batch_id INTEGER NOT NULL,
    parameter_name VARCHAR(50) NOT NULL,
    value DECIMAL NOT NULL,
    unit VARCHAR(20) NOT NULL
);

COMMIT;

-- Транзакция 2: тестовые данные
BEGIN;

INSERT INTO t1_positions (name) VALUES ('Командир'), ('Наводчик'), ('Заряжающий');

INSERT INTO t1_users (login, full_name, position_id) VALUES 
('USR01', 'Иванов Иван Иванович', 1),
('USR02', 'Петров Петр Петрович', 2);

INSERT INTO t1_batches (batch_number, user_id, measured_at) VALUES 
