-- Удаление внешнего ключа из batches

ALTER TABLE batches DROP CONSTRAINT batches_parameter_id_fkey;


-- Перестройка таблицы parameters
-- Старая parameters была справочником параметров
-- Новая parameters будет хранить фактические измерения

-- Создаём таблицу с новой структурой
CREATE TABLE parameters_new (
    id INTEGER NOT NULL PRIMARY KEY,
    parameter_type_id INTEGER NOT NULL REFERENCES parameter_types (id),
    value DECIMAL NOT NULL,
    batch_id INTEGER NOT NULL
);

-- Мигрируем данные
INSERT INTO parameters_new (id, parameter_type_id, value, batch_id)
SELECT
    b.id,
    b.parameter_id,
    b.param_value,
    b.id
FROM batches AS b;

-- Удаляем старую таблицу parameters
DROP TABLE parameters;

-- Переименовываем новую таблицу
ALTER TABLE parameters_new RENAME TO parameters;

--Очистка таблицы batches

-- Удаляем дубликаты
DELETE FROM batches
WHERE id NOT IN (
    SELECT MIN(id)
    FROM batches
    GROUP BY batch_number
);

-- Удаляем поля, которые теперь хранятся в parameters
ALTER TABLE batches DROP COLUMN parameter_id;
ALTER TABLE batches DROP COLUMN param_value;
ALTER TABLE batches DROP COLUMN batch_number;

-- Итоговый запрос

SELECT
    b.time_at AS "Дата измерения",
    b.id AS "Номер пачки",
    u.full_name AS "ФИО сотрудника",
    pt.name || ', ' || bu.name AS "Параметр и ед. изм.",
    p.value AS "Значение"
FROM batches AS b
    JOIN parameters AS p ON p.batch_id = b.id
    JOIN users AS u ON u.id = b.user_id
    JOIN parameter_types AS pt ON pt.id = p.parameter_type_id
    JOIN base_units AS bu ON bu.parameter_type_id = pt.id
ORDER BY b.time_at, b.id, pt.id;