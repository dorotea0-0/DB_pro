(1002, 2, '2026-10-10 11:30:00');

INSERT INTO t1_measurements (batch_id, parameter_name, value, unit) VALUES 
(1, 'Температура', 15.5, 'грC'),
(1, 'Давление', 750, 'гПа'),
(2, 'Ветер', 4.5, 'м/с');

COMMIT;

-- Транзакция 3: связи и ограничения
BEGIN;

ALTER TABLE t1_users ADD CONSTRAINT fk_t1_users_pos 
    FOREIGN KEY (position_id) REFERENCES t1_positions(id) ON DELETE RESTRICT;

ALTER TABLE t1_batches ADD CONSTRAINT fk_t1_batches_usr 
    FOREIGN KEY (user_id) REFERENCES t1_users(id) ON DELETE CASCADE;

ALTER TABLE t1_measurements ADD CONSTRAINT fk_t1_meas_batch 
    FOREIGN KEY (batch_id) REFERENCES t1_batches(id) ON DELETE CASCADE;

ALTER TABLE t1_batches ADD CONSTRAINT chk_t1_batch_pos 
    CHECK (batch_number > 0);

COMMIT;

--Задание 2 метаданные

SELECT 
    ROW_NUMBER() OVER (ORDER BY table_name) AS "№",
    table_name AS "Наименование",
    'Таблица' AS "Тип"
FROM information_schema.tables 
WHERE table_schema = 'public' AND table_type = 'BASE TABLE'
ORDER BY "№";

--Итоговые запросы

-- Основной отчёт по пачкам
SELECT
    b.time_at AS "Дата измерения",
    b.id AS "Номер пачки",
    u.full_name AS "ФИО сотрудника",
    pt.name || ', ' || bu.name AS "Параметр и ед. изм.",
    p.value AS "Значение"
FROM batches AS b
    JOIN parameters AS p ON p.batch_id = b.id
    JOIN users AS u ON u.id = b.user_id
    JOIN parameter_types AS pt ON pt.id = p.parameter_type_id
    JOIN base_units AS bu ON bu.parameter_type_id = pt.id
ORDER BY b.time_at, b.id, pt.id;

-- Отчёт по расчётам температуры
SELECT 
    tc.id AS "№",
    b.id AS "Пачка",
    u.full_name AS "Сотрудник",
    tc.original_celsius AS "°C",
    tc.calculated_kelvin AS "K",
    tc.calculation_rule AS "Правило"
FROM temperature_calculations tc
JOIN batches b ON tc.batch_id = b.id
JOIN users u ON b.user_id = u.id
ORDER BY tc.id;